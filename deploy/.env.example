# IP que les clients utilisent pour joindre la VM (publique, ou celle du LAN pour un test local)
PUBLIC_IP=203.0.113.10
# Générer avec : openssl rand -hex 32
ORIA_TURN_SECRET=CHANGE_ME
# Seulement si la VM a une IP privée derrière un NAT/routeur (Proxmox à la maison, par ex.) : "IP_PUBLIQUE/IP_PRIVEE_DE_LA_VM"
# TURN_EXTERNAL_IP=203.0.113.10/192.168.1.50
